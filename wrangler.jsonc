{
  "name": "kazoku-dandori",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "FAMILY", "class_name": "Family" },
      { "name": "DIRECTORY", "class_name": "Directory" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Family"] },
    { "tag": "v2", "new_sqlite_classes": ["Directory"] }
  ],
  // お便りの写真と「残して」と言われた写真。家族ごとのフォルダ。外から直接は開けない
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "kazoku-dandori-photos" }],
  // リッチメニューの画像（docs/assets/richmenu.png）を Worker に同梱して LINE に上げる
  "rules": [{ "type": "Data", "globs": ["**/*.png"], "fallthrough": true }],
  "observability": { "enabled": true }
}
